{
  "name": "@ameshkin/nextcrumbs",
  "version": "0.2.1",
  "description": "MUI breadcrumbs with Next.js Link support, optional URL auto-generation, and SEO microdata.",
  "license": "MIT",
  "type": "module",
  "author": "Amir Meshkin <amir.meshkin@gmail.com> (https://github.com/ameshkin)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./breadcrumbs": {
      "types": "./dist/Breadcrumbs.d.ts",
      "import": "./dist/Breadcrumbs.js"
    },
    "./hooks/usePathBreadcrumbs": {
      "types": "./dist/hooks/usePathBreadcrumbs.d.ts",
      "import": "./dist/hooks/usePathBreadcrumbs.js"
    },
    "./hooks/useReactRouterBreadcrumbs": {
      "types": "./dist/hooks/useReactRouterBreadcrumbs.d.ts",
      "import": "./dist/hooks/useReactRouterBreadcrumbs.js"
    },
    "./utils/jsonld": {
      "types": "./dist/utils/jsonld.d.ts",
      "import": "./dist/utils/jsonld.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "tsup --clean",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e:ui": "playwright test",
    "test:e2e:bdd": "cucumber-js \"tests/e2e/features/**/*.feature\" --require \"tests/e2e/steps/**/*.mjs\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "ci": "npm run typecheck && npm run test:run && npm run build",
    "prepublishOnly": "npm run ci",
    "publish:all": "npm run ci && npm version patch -m \"chore(release): %s\" && git push --follow-tags && npm publish --access public --registry https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^28.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameshkin/nextcrumbs.git"
  },
  "bugs": {
    "url": "https://github.com/ameshkin/nextcrumbs/issues"
  },
  "homepage": "https://github.com/ameshkin/nextcrumbs#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ameshkin"
  },
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  },
  "packageManager": "npm@12.2.1",
  "keywords": [
    "mui",
    "breadcrumbs",
    "nextjs",
    "react",
    "material-ui",
    "seo",
    "schema.org",
    "app router",
    "react router"
  ],
  "publishConfig": {
    "access": "public"
  }
}
